# SBN Auto zbiralnik — skopirajte v .env in izpolnite.
# Te vrednosti so skrivnosti: .env NIKOLI ne sme v git.

# Supabase (projekt kodatim-si) — Settings -> API
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Katere znamke spremljamo. PRAZNO = cel trg osebnih vozil, kar je tudi
# priporočeno: en pregled brez filtra je manj zahtevkov in bolj popoln kot
# vrtenje po seznamu znamk.
AVTONET_ZNAMKE=

# --- Kdaj se pregled zažene ------------------------------------------------
# Privzeto NIKOLI sam: worker čaka na gumb "ZAŽENI RESEARCH" na kodatim.si/avtonet.
# Klik zapiše vrstico v avtonet_raziskave, worker jo pobere in vanjo sproti
# piše napredek. Šele ko je ročni pregled preverjen od začetka do konca, se
# spodnji urnik prižge z AVTONET_URNIK=1.
AVTONET_URNIK=

# Kako pogosto pogleda, ali je prišla zahteva iz nadzorne plošče (ms).
AVTONET_POLL_MS=15000

# Ob katerih urah se začne pregled — velja SAMO pri AVTONET_URNIK=1.
# "6,18" = dvakrat dnevno; "6" = enkrat.
AVTONET_RESEARCH_HOURS=6,18

# Koliko strani rezultatov največ. 0 = brez omejitve (cel trg, ~1.100 strani).
# Za test nastavite npr. 3.
AVTONET_MAX_PAGES=0

# Koliko oglasov naj 2. faza odpre (stran posameznega oglasa: oprema, kraj,
# prodajalec, barva, karoserija). 0 = vse, ki jim podrobnosti še manjkajo.
AVTONET_DETAIL_LIMIT=0

# Po kolikšnem molku velja raziskava za zapuščeno in se prevzame v
# nadaljevanje. Zaščita pred workerjem, ki je padel sredi pregleda (ms).
AVTONET_STALE_AFTER_MS=900000

# Razmik med zahtevki (ms). 10000 je to, kar avto.net prosi v robots.txt.
# Nižje ne nastavljajte — to je edina obljuba, ki jo viru damo.
AVTONET_CRAWL_DELAY_MS=10000

# Zaporednih neuspehov, preden se worker označi kot ustavljen.
AVTONET_MAX_FAILURES=5

# Najmanjši vzorec, preden model sploh nastopi v statistiki hitrosti prodaje.
# Pod tem je "mediana dni do prodaje" šum, ki izgleda kot vpogled.
AVTONET_MIN_VZOREC=20

# --- Dnevno poročilo (neobvezno) -------------------------------------------
# Brez teh treh se poročilo vseeno izračuna in zabeleži v dnevnik, samo pošlje
# se ne. Manjkajoč ključ nikoli ne pomeni manjkajočega poročila.
# RESEND_API_KEY=
# REPORT_EMAIL_TO=luka@kodatim.si
# REPORT_EMAIL_FROM=SBN Auto <porocila@kodatim.si>
# REPORT_HOUR=7
