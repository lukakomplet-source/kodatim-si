# SBN Auto zbiralnik — skopirajte v .env in izpolnite.
# Te vrednosti so skrivnosti: .env NIKOLI ne sme v git.

# Supabase (projekt kodatim-si) — Settings -> API
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Katere znamke spremljamo. PRAZNO = cel trg osebnih vozil, kar je tudi
# priporočeno: en pregled brez filtra je manj zahtevkov in bolj popoln kot
# vrtenje po seznamu znamk.
AVTONET_ZNAMKE=

# --- Kdaj se pregled zažene ------------------------------------------------
# Z AVTONET_URNIK=1 urnik ob spodnjih urah SAM odda zahtevo — isti mehanizem
# kot gumb "ZAŽENI RESEARCH", ista koda z rezinami. Brez njega worker čaka
# samo na gumb.
AVTONET_URNIK=1

# Kako pogosto pogleda, ali je prišla zahteva iz nadzorne plošče (ms).
AVTONET_POLL_MS=15000

# Ure ZAČETKA pregleda. Pregled seznama traja ~2 h, zato so privzete ure
# nastavljene glede na človekov dan: 5 -> končano do ~7 (ob 8h na šihtu že
# vidiš nove), 10 -> končano do ~12 (nov avto še pokličeš isti dan), 22 -> nočni.
# Če raziskava ob terminu še teče, se termin preskoči (naenkrat teče samo ena).
AVTONET_RESEARCH_HOURS=5,10,22

# Koliko strani rezultatov največ. 0 = brez omejitve (cel trg, ~1.100 strani).
# Za test nastavite npr. 3.
AVTONET_MAX_PAGES=0

# Koliko oglasov naj 2. faza odpre (stran posameznega oglasa: oprema, kraj,
# prodajalec, barva, karoserija). 0 = vse, ki jim podrobnosti še manjkajo.
AVTONET_DETAIL_LIMIT=0

# Po kolikšnem molku velja raziskava za zapuščeno in se prevzame v
# nadaljevanje. Zaščita pred workerjem, ki je padel sredi pregleda (ms).
AVTONET_STALE_AFTER_MS=900000

# --- Hitrost pregleda ------------------------------------------------------
# avto.netov robots.txt prosi za 10 s med zahtevki. Uporabnik je izbral hitreje,
# z avtomatskim upočasnjevanjem ob 429/403. Če vir začne blokirati, se vrni na
# varno: AVTONET_DELAY_LIST_MS=10000, AVTONET_DELAY_DETAIL_MS=10000,
# AVTONET_DETAIL_CONCURRENCY=1.
AVTONET_DELAY_LIST_MS=3000        # razmik med rezultatnimi stranmi
AVTONET_DELAY_DETAIL_MS=2500      # razmik med stranmi posameznih oglasov (na delavca)
AVTONET_DETAIL_CONCURRENCY=2      # koliko oglasov hkrati v 2. fazi (majhno!)
AVTONET_MAX_BLOKAD=4             # zaporednih blokad, preden 2. faza odneha

# Meja rezultatov na eno poizvedbo (avto.net vrne največ toliko in nato ponavlja).
# Nad tem se rezina samodejno razdeli (znamka -> cena -> letnik).
AVTONET_CAP=1000

# Stara enotna nastavitev; ohranjena za združljivost, a je novi razmiki zgoraj
# ne uporabljajo.
AVTONET_CRAWL_DELAY_MS=10000

# Zaporednih neuspehov, preden se worker označi kot ustavljen.
AVTONET_MAX_FAILURES=5

# Najmanjši vzorec, preden model sploh nastopi v statistiki hitrosti prodaje.
# Pod tem je "mediana dni do prodaje" šum, ki izgleda kot vpogled.
AVTONET_MIN_VZOREC=20

# --- Dnevno poročilo (neobvezno) -------------------------------------------
# Brez teh treh se poročilo vseeno izračuna in zabeleži v dnevnik, samo pošlje
# se ne. Manjkajoč ključ nikoli ne pomeni manjkajočega poročila.
# RESEND_API_KEY=
# REPORT_EMAIL_TO=luka@kodatim.si
# REPORT_EMAIL_FROM=SBN Auto <porocila@kodatim.si>
# REPORT_HOUR=7
