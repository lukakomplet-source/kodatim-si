# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which holds only placeholders and is the one thing
# setup.ps1 needs on a fresh clone. Without this line `.env*` swallowed it and
# the automated setup broke on a machine that had never seen the file. The
# pattern has no slash and matches the exact name, so real secrets — .env,
# .env.local, .env.production — stay ignored.
!.env.example

# avtodeploy (dnevniki, pid streznika, varnostna kopija prejsnjega builda)
.avtodeploy/
.next_prejsnja/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*

# Zaklep, ki ga je ustvarjala napaka z neubezanimi posevnicami v poti
# (worker-avtonet/src/pdf-arhiv.ts). Pot je popravljena; ce se datoteka s tem
# imenom se kdaj pojavi, pomeni, da tece stara koda.
*pdf-arhiv.lock
