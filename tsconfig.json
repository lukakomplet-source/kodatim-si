{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@urvis/*": [
        "./src/_urvis/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next_nova/types/**/*.ts",
    ".next_nova/dev/types/**/*.ts"
  ],
  // scripts/ so samostojna orodja, ki tecejo pod tsx (uvazajo .ts poti
  // neposredno) — niso del Next gradnje in jih zato tu ne preverjamo.
  "exclude": [
    "node_modules",
    "worker-avtonet",
    "worker-podjetja",
    "worker-render",
    "scripts"
  ]
}
