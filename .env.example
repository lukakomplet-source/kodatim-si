# KodaTim — okoljske spremenljivke (primer). Kopiraj v .env.local in izpolni.
# NIKOLI ne commitaj .env.local — .gitignore ga že ignorira.

# --- Supabase --------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI (AI dopolnjevanje, cenilnik vozil) -----------------------------
OPENAI_API_KEY=

# --- Firecrawl (spletni scrape / iskanje) ----------------------------------
FIRECRAWL_API_KEY=

# --- E-pošta ----------------------------------------------------------------
# KodaTim pošilja prek dispečerja v src/lib/email.ts:
#   če so nastavljeni LISTMONK_* → gre prek Listmonka
#   sicer → fallback na Resend REST (spodaj)
#
# Listmonk (primarni prenos). LISTMONK_URL mora biti JAVNO dosegljiv HTTPS —
# Vercel ne more klicati localhost. LISTMONK_TX_TEMPLATE_ID je ID transactional
# "passthrough" predloge (glej docs/listmonk-email-setup.md).
LISTMONK_URL=
LISTMONK_API_USER=
LISTMONK_API_TOKEN=
LISTMONK_TX_TEMPLATE_ID=

# Resend (fallback in/ali SMTP relay za Listmonk). RESEND_FROM_EMAIL mora biti
# na v Resendu potrjeni domeni, npr. "KodaTim <obvestila@kodatim.si>".
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Javni naslov (za povezave v e-pošti) ----------------------------------
NEXT_PUBLIC_SITE_URL=https://www.kodatim.si
